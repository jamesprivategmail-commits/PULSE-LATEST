{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "description": "Display name" },
        "handle": { "type": "string", "description": "Unique @handle" },
        "email": { "type": "string", "description": "Email address" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "bio": { "type": "string", "description": "Profile biography" },
        "followers": { "type": "number", "description": "Follower count" },
        "following": { "type": "number", "description": "Following count" },
        "likesReceived": { "type": "number", "description": "Total likes received" },
        "createdAt": { "type": "number", "description": "Account timestamp" },
        "emailVerified": { "type": "boolean", "description": "Email verification state" },
        "verified": { "type": "boolean", "description": "Official verified badge" },
        "banned": { "type": "boolean", "description": "Account suspension status" },
        "banReason": { "type": "string", "description": "Reason for account suspension" },
        "bannedAt": { "type": "number", "description": "Timestamp of suspension" },
        "role": { "type": "string", "description": "User role: admin or user" }
      }
    },
    "Video": {
      "collection": "videos",
      "fields": {
        "src": { "type": "string", "description": "Video stream or storage URL" },
        "caption": { "type": "string", "description": "Video caption text" },
        "sound": { "type": "string", "description": "Audio track title" },
        "ownerUid": { "type": "string", "description": "Creator User ID" },
        "ownerHandle": { "type": "string", "description": "Creator Handle" },
        "ownerUsername": { "type": "string", "description": "Creator Username" },
        "ownerAvatar": { "type": "string", "description": "Creator Avatar" },
        "verified": { "type": "boolean", "description": "Creator verified status" },
        "likeCount": { "type": "number", "description": "Total likes" },
        "commentCount": { "type": "number", "description": "Total comments" },
        "shareCount": { "type": "number", "description": "Total shares" },
        "saveCount": { "type": "number", "description": "Total saves" },
        "tags": { "type": "array", "description": "Hashtags attached to the video" },
        "createdAt": { "type": "number", "description": "Upload timestamp" }
      }
    },
    "Appeal": {
      "collection": "appeals",
      "fields": {
        "uid": { "type": "string", "description": "Suspended user UID" },
        "username": { "type": "string", "description": "User display name" },
        "handle": { "type": "string", "description": "User handle" },
        "email": { "type": "string", "description": "User contact email" },
        "reason": { "type": "string", "description": "Ban reason recorded on profile" },
        "appealText": { "type": "string", "description": "Explanation why account should be unbanned" },
        "contactInfo": { "type": "string", "description": "Contact info / Telegram handle" },
        "status": { "type": "string", "description": "Status: pending, approved, or rejected" },
        "createdAt": { "type": "number", "description": "Submission timestamp" },
        "reviewedAt": { "type": "number", "description": "Review timestamp" },
        "reviewedBy": { "type": "string", "description": "Reviewing admin or Telegram bot" }
      }
    }
  }
}
