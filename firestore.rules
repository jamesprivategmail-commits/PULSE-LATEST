rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default catch-all denies unhandled routes
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // User profiles & user subcollections
    match /users/{userId} {
      // Public profiles: any user can read and manage profiles and stats
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();

      match /notifications/{notifId} {
        allow read, write: if true;
      }

      match /following/{followingId} {
        allow read, write: if true;
      }

      match /followers/{followerId} {
        allow read, write: if true;
      }

      match /likedVideos/{videoId} {
        allow read, write: if true;
      }

      match /savedVideos/{videoId} {
        allow read, write: if true;
      }

      match /reposts/{repostId} {
        allow read, write: if true;
      }

      match /watch_history/{videoId} {
        allow read, write: if true;
      }

      match /wallet_transactions/{txId} {
        allow read, write: if true;
      }

      match /tips_received/{tipId} {
        allow read, write: if true;
      }
    }

    // Video posts & comments & likes
    match /videos/{videoId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn();

      match /likes/{likeId} {
        allow read, write: if true;
      }

      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // Ephemeral stories
    match /stories/{storyId} {
      allow read, write: if true;
    }

    // Story highlights
    match /highlights/{highlightId} {
      allow read, write: if true;
    }

    // Live streams & live chat & gifts
    match /livestreams/{streamId} {
      allow read, write: if true;

      match /chat/{msgId} {
        allow read, write: if true;
      }

      match /gifts/{giftId} {
        allow read, write: if true;
      }
    }

    match /livereplays/{replayId} {
      allow read, write: if true;
    }

    // Chats and messaging
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /groups/{groupId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Direct calling signaling
    match /calls/{callId} {
      allow read, write: if true;
    }

    // Follow relationships
    match /follows/{uid}/{subcollection=**} {
      allow read, write: if true;
    }

    match /user_relationships/{relId} {
      allow read, write: if true;
    }

    // Notifications top-level routing
    match /notifications/{uid}/items/{itemId} {
      allow read, write: if true;
    }

    // Moderation, safety, reports & appeals
    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /appeals/{appealId} {
      allow read, write: if true;
    }

    match /owner_feedback/{feedbackId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /account_deletion_requests/{reqId} {
      allow read, write: if true;
    }

    match /playlists/{playlistId} {
      allow read, write: if true;
    }

    match /scheduled_posts/{postId} {
      allow read, write: if true;
    }

    match /opay_topups/{topupId} {
      allow read, write: if true;
    }

    match /payout_requests/{reqId} {
      allow read, write: if true;
    }

    match /searchLogs/{logId} {
      allow create, read: if true;
    }

    match /familyPairings/{code} {
      allow read, write: if true;
    }
  }
}
