# GROQ_API_KEY: Required for Groq AI inference calls (captions, hashtags, hooks)
GROQ_API_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot token for central administration and moderation
TELEGRAM_BOT_TOKEN="8991376058:AAEMmxkwfs-pjwG1T8vHW8Nc2nNoXx_0ywA"

# Telegram Admin Handle
TELEGRAM_ADMIN_HANDLE="@nova_tech_1"
# Numeric Telegram chat/user id of the admin — set this for real authorization.
# Get it by messaging the bot once and checking the update's chat.id (e.g. via
# /getUpdates), or from @userinfobot. Falls back to matching TELEGRAM_ADMIN_HANDLE
# by @username if left blank, which is weaker but still enforced.
TELEGRAM_ADMIN_CHAT_ID=""

# LiveKit WebRTC Real-Time Audio/Video Live Streaming credentials
LIVEKIT_URL="wss://pulse-hl0tqpe5.livekit.cloud"
LIVEKIT_API_KEY="APIWdyuKAmWMR7U"
